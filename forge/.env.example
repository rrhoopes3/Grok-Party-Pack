# THE FORGE - Environment Variables
# Copy this to .env and fill in your keys

# Core API Keys
XAI_API_KEY=your_xai_api_key_here
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Local LLM endpoints (optional)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
OLLAMA_BASE_URL=http://localhost:11434/v1

# Polymarket / Trading
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_ADDRESS=
POLYMARKET_PRIVATE_KEY=

# Solana (for Toll Protocol)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
SOLANA_WALLET_PRIVATE_KEY=

# Optional services
SERPER_API_KEY=your_serper_key
BROWSERLESS_URL=wss://chrome.browserless.io

# Arena / Evaluation
ZEUS_MODEL=grok-4.20-0309-reasoning
MUSES_MODEL=claude-sonnet-4-20250514

# MCP / External
MCP_TRANSPORT=stdio
DEBUG=true
